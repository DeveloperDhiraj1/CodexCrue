NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cortexcrew
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRE=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=codex_refresh_token
ML_SERVICE_URL=http://127.0.0.1:8000
ML_CANDIDATE_LIMIT=1000
# Gemini (free): https://aistudio.google.com/apikey — key must start with AIza
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=600
AI_HISTORY_LIMIT=20
RECOMMENDATION_WEIGHT_ML=0.30
RECOMMENDATION_WEIGHT_SKILL=0.15
RECOMMENDATION_WEIGHT_GOAL=0.15
RECOMMENDATION_WEIGHT_COMMENT=0.15
RECOMMENDATION_WEIGHT_QUALITY=0.10
RECOMMENDATION_WEIGHT_TIME_FIT=0.05
RECOMMENDATION_WEIGHT_PREREQUISITE=0.05
RECOMMENDATION_WEIGHT_PREFERENCE=0.05
RECOMMENDATION_WEIGHT_FEEDBACK=0.05
CORS_ORIGIN=http://localhost:3000
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
REDIS_REQUIRED=false
